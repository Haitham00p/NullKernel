#include <stdio.h>

void main(void)
{
    puts("A journey of a thousand lines begins with a single compile.");
    puts("If it compiles, ship it.");
    puts("The best camera is the one in your kernel.");
    puts("Perfection is achieved when there is nothing left to delete.");
    puts("There are only two hard things in kernel dev:");
    puts("cache invalidation and ncc bugs.");
    puts("Your source is only as safe as your reboot loop.");
    puts("When in doubt, format.");
}
